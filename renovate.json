{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "argocd": {
    "managerFilePatterns": ["/kubernetes/.+/application\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Never bump sealed-secrets and traefik together: if sealing breaks you lose the Cloudflare token and ACME with it.",
      "matchPackageNames": ["sealed-secrets", "traefik"],
      "groupName": null,
      "schedule": ["before 9am on monday"]
    },
    {
      "description": "Kubernetes control plane and GitOps engine get their own PRs.",
      "matchPackageNames": ["argo-cd", "kube-prometheus-stack"],
      "automerge": false
    }
  ]
}
